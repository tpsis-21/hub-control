{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:security": "jest src/__tests__/security.test.ts",
    "init:notifications": "node scripts/init-notifications.js",
    "notifications:setup": "node scripts/init-notifications.js",
    "notifications:test": "node scripts/init-notifications.js --test-only",
    "notifications:check": "node scripts/check-notification-system.js",
    "analyze:bundle": "node scripts/bundle-analysis.js",
    "optimize:bundle": "node scripts/optimize-bundle.js",
    "build:analyze": "npm run build && npm run analyze:bundle",
    "build:optimized": "npm run optimize:bundle && npm run build",
    "build:static": "next build",
    "build:prod": "NODE_ENV=production npm run build",
    "deploy:prod": "vercel --prod",
    "deploy:preview": "vercel",
    "check:prod": "npm run typecheck && npm run lint && npm run test",
    "pre-deploy": "node scripts/pre-deploy-check.js",
    "deploy:full": "npm run pre-deploy && npm run build && vercel --prod",
    "deploy:safe": "npm run pre-deploy && npm run build && vercel",
    "monitoring:setup": "node scripts/setup-monitoring.js",
    "monitoring:test": "npm run monitoring:health && npm run monitoring:metrics",
    "monitoring:health": "curl -f http://localhost:3000/api/health || echo 'Health check failed'",
    "monitoring:metrics": "curl -f http://localhost:3000/api/metrics || echo 'Metrics check failed'",
    "monitoring:dashboard": "curl -f http://localhost:3000/api/monitoring/dashboard || echo 'Dashboard check failed'",
    "logs:view": "tail -f logs/info.log",
    "logs:errors": "tail -f logs/error.log",
    "logs:clear": "rm -f logs/*.log && echo 'Logs cleared'",
    "backup:setup": "node scripts/setup-backup.js",
    "backup:test": "node scripts/test-backup.js",
    "backup:full": "node scripts/run-backup.js full",
    "backup:incremental": "node scripts/run-backup.js incremental",
    "backup:logs": "node scripts/run-backup.js logs",
    "backup:list": "node -e \"const {BackupManager} = require('./src/lib/backup'); const fs = require('fs'); const config = JSON.parse(fs.readFileSync('./config/backup.json', 'utf8')); new BackupManager(config).listBackups().then(console.log);\"",
    "backup:cleanup": "node -e \"const {BackupManager} = require('./src/lib/backup'); const fs = require('fs'); const config = JSON.parse(fs.readFileSync('./config/backup.json', 'utf8')); new BackupManager(config).cleanupOldBackups().then(console.log);\"",
    "backup:restore": "node -e \"if(!process.argv[2]) { console.error('Uso: npm run backup:restore <backup-id>'); process.exit(1); } const {BackupManager} = require('./src/lib/backup'); const fs = require('fs'); const config = JSON.parse(fs.readFileSync('./config/backup.json', 'utf8')); new BackupManager(config).restoreBackup(process.argv[2]).then(console.log);\" --",
    "security:setup": "node scripts/setup-security.js",
    "security:test": "node scripts/test-security.js",
    "security:audit": "node security/run-audit.js",
    "security:quick-check": "node -e \"console.log('Executando verificação rápida...'); require('./src/lib/security-audit').SecurityAuditor.quickCheck().then(r => console.log('Score:', r.score))\"",
    "security:report": "node -e \"const fs=require('fs'); const reports=fs.readdirSync('./security/reports').filter(f=>f.endsWith('.json')); console.log('Relatórios disponíveis:', reports)\"",
    "security:cleanup": "node -e \"const fs=require('fs'); const path=require('path'); const dir='./security/reports'; const files=fs.readdirSync(dir); const old=files.filter(f=>Date.now()-fs.statSync(path.join(dir,f)).mtime>30*24*60*60*1000); old.forEach(f=>fs.unlinkSync(path.join(dir,f))); console.log('Removidos:', old.length, 'relatórios antigos')\"",
    "performance:setup": "node scripts/setup-performance.js",
    "performance:test": "node scripts/test-performance.js",
    "performance:quick": "node performance/scripts/run-test.js",
    "performance:list": "node scripts/list-performance-results.js",
    "performance:cleanup": "node scripts/cleanup-performance.js",
    "test:bpix-prod": "node scripts/test-bpix-production.js",
    "validate:bpix": "npm run test:bpix-prod && npm run check:prod",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:automation": "cross-env NODE_ENV=test jest --testPathPatterns=automation",
    "storage:verify": "node scripts/verify-storage-setup.js",
    "storage:setup": "echo 'Consulte docs/supabase-storage-setup.md para instruções de configuração manual'"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^9.40.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.39.7",
    "@types/nodemailer": "^6.4.17",
    "canvas": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.4",
    "lucide-react": "^0.475.0",
    "next": "^15.5.2",
    "next-themes": "^0.3.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.8",
    "papaparse": "^5.4.1",
    "patch-package": "^8.0.0",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "web-vitals": "^3.5.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-attributes": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.14",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.0.5",
    "cross-env": "^10.0.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8",
    "puppeteer": "^24.22.2",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5"
  }
}
