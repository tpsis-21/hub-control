// src/middleware.ts
import { createMiddlewareClient } from '@supabase/auth-helpers-nextjs'
import { NextResponse } from 'next/server'
import type { NextRequest } from 'next/server'

export async function middleware(req: NextRequest) {
  const res = NextResponse.next()
  const supabase = createMiddlewareClient({ req, res })

  // Verificar se o usuário está autenticado
  const {
    data: { session },
  } = await supabase.auth.getSession()

  // Rotas que não precisam de autenticação
  const publicRoutes = ['/login', '/register', '/forgot-password', '/reset-password']
  const isPublicRoute = publicRoutes.some(route => req.nextUrl.pathname.startsWith(route))
  
  // Rotas da área do cliente (acessíveis via link único)
  const isClientAreaRoute = req.nextUrl.pathname.startsWith('/cliente/')

  // Redirecionar usuários não autenticados para a página de login
  if (!session && !isPublicRoute && !isClientAreaRoute) {
    const redirectUrl = new URL('/login', req.url)
    redirectUrl.searchParams.set('redirectedFrom', req.nextUrl.pathname)
    return NextResponse.redirect(redirectUrl)
  }

  // Redirecionar usuários autenticados para o dashboard se tentarem acessar páginas públicas
  if (session && isPublicRoute) {
    return NextResponse.redirect(new URL('/dashboard', req.url))
  }

  return res
}

// Aplicar o middleware apenas às rotas especificadas
export const config = {
  matcher: [
    /*
     * Corresponde a todas as rotas, exceto:
     * - Arquivos estáticos (/_next/static/...)
     * - Arquivos de imagem (/_next/image/...)
     * - API routes (/api/...)
     */
    '/(.*)',
    '/(api)/(.*)',
  ],
}