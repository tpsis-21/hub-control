// @/app/(app)/dashboard/dashboard-content.tsx
"use client";

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { DollarSign, Users, FlaskConical, Clock, UserCheck, Calendar, History, UserX, AlertTriangle, CalendarCheck, CalendarClock, TrendingUp, TrendingDown, Activity, Zap, Target, BarChart3 } from "lucide-react";
import Link from "next/link";
import { FormattedDate } from "@/components/app/formatted-date";
import { AddCustomerForm } from "@/app/(app)/clientes/add-customer-form";
import { Avatar, AvatarFallback } from "@/components/ui/avatar";
import type { Client, Plan, Server } from "@/lib/types";
import { Skeleton } from "@/components/ui/skeleton";
import { AddTestForm } from "@/app/(app)/testes/add-test-form";
import { useDashboardMetrics } from "@/hooks/useDashboardMetrics";
import { useTestConversionRate } from "@/hooks/useTestConversionRate";
import { useErrorHandler } from "@/hooks/useErrorHandler";
import { Badge } from "@/components/ui/badge";
import { scheduleStatusUpdates } from "@/lib/client-status-updater";



type DashboardContentProps = {
    allClients: Client[];
    allTests?: Client[];
    allPlans: Plan[];
    allServers: Server[];
}

export function DashboardContent({ allClients, allTests = [], allPlans, allServers }: DashboardContentProps) {
  const { handleError } = useErrorHandler();
  
  // Ativar atualização automática de status dos clientes
  scheduleStatusUpdates();
  
  // Usar hooks especializados para cálculos
  const metrics = useDashboardMetrics(allClients, allTests, allPlans);
  const conversionRate = useTestConversionRate(allClients);
  
  // Tratamento de erro para dados inválidos
  if (!allClients || !allPlans) {
    handleError(new Error('Dados necessários não foram carregados'), 'Dashboard');
    return null;
  }

  if (!metrics) {
    return (
       <div className="space-y-4">
            <div className="grid gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
                {[...Array(8)].map((_, i) => (
                    <Card key={i}>
                        <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                            <Skeleton className="h-4 w-32" />
                        </CardHeader>
                        <CardContent>
                            <Skeleton className="h-8 w-24 mb-2" />
                            <Skeleton className="h-3 w-40" />
                        </CardContent>
                    </Card>
                ))}
            </div>
             <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-2">
                 <Card>
                    <CardHeader>
                        <CardTitle>Clientes Vencendo Hoje</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-4">
                        <Skeleton className="h-10 w-full" />
                        <Skeleton className="h-10 w-full" />
                    </CardContent>
                </Card>
                  <Card>
                    <CardHeader>
                        <CardTitle>Novos Clientes Adicionados</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-4">
                        <Skeleton className="h-10 w-full" />
                        <Skeleton className="h-10 w-full" />
                    </CardContent>
                </Card>
            </div>
        </div>
    );
  }

  return (
    <div className="flex flex-1 flex-col gap-4">
        <div className="flex justify-end gap-2">
            <AddTestForm plans={allPlans} servers={allServers} />
            <AddCustomerForm plans={allPlans} servers={allServers} />
        </div>
      {/* Seção de Faturamento */}
      <div className="space-y-4">
          <h2 className="text-xl font-semibold tracking-tight">Faturamento</h2>
            <div className="grid gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Receita do Mês</CardTitle>
                <DollarSign className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">R$ {metrics.monthlyRevenue.toFixed(2)}</div>
                  <p className={`text-xs ${metrics.revenueStatus === 'positivo' ? 'text-emerald-600' : 'text-red-600'}`}>
                  {metrics.revenueStatus === 'positivo' ? '+' : ''}{metrics.revenueDifference.toFixed(1)}% em relação ao mês anterior
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Receita Mês Anterior</CardTitle>
                <History className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">R$ {metrics.previousMonthRevenue.toFixed(2)}</div>
                <p className="text-xs text-muted-foreground">
                  Faturamento de <FormattedDate dateString={metrics.previousMonthName} format="LLLL" />
                </p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Receita no Ano</CardTitle>
                <Calendar className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">R$ {metrics.yearlyRevenue.toFixed(2)}</div>
                <p className="text-xs text-muted-foreground">
                  Total para o ano de {metrics.currentYear}
                </p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Novos Clientes no Mês</CardTitle>
                <Users className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">+{metrics.newCustomersThisMonth}</div>
                <p className="text-xs text-muted-foreground">
                  no mês de <FormattedDate dateString={metrics.currentMonthName} format="LLLL" />
                </p>
              </CardContent>
            </Card>
          </div>
      </div>

      {/* Seção de Clientes e Vencimentos */}
      <div className="space-y-4">
          <h2 className="text-xl font-semibold tracking-tight">Clientes e Vencimentos</h2>
          <div className="grid gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Clientes Ativos</CardTitle>
                <UserCheck className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.totalActiveClients}</div>
                <p className="text-xs text-muted-foreground">Total de clientes com assinatura ativa</p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Total de Vencidos</CardTitle>
                <UserX className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.totalOverdueClients}</div>
                  <p className="text-xs text-muted-foreground">Assinaturas com data de expiração passada</p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Vencidos Ontem</CardTitle>
                <AlertTriangle className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.expiringYesterday}</div>
                <p className="text-xs text-muted-foreground">Clientes que venceram ontem</p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Vence Hoje</CardTitle>
                <CalendarCheck className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.expiringToday.length}</div>
                  <p className="text-xs text-muted-foreground">Clientes que vencem hoje</p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Vence Amanhã</CardTitle>
                <CalendarClock className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.expiringTomorrow}</div>
                <p className="text-xs text-muted-foreground">Clientes que vencem amanhã</p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Vence em 3 dias</CardTitle>
                <Clock className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.expiringIn3Days}</div>
                  <p className="text-xs text-muted-foreground">Vencimentos nos próximos 3 dias</p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Testes Ativos</CardTitle>
                <FlaskConical className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.activeTests}</div>
                <p className="text-xs text-muted-foreground">
                  Usuários testando agora
                </p>
              </CardContent>
            </Card>
              <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Taxa de Conversão</CardTitle>
                {conversionRate.trend === 'up' ? (
                  <TrendingUp className="h-4 w-4 text-emerald-600" />
                ) : conversionRate.trend === 'down' ? (
                  <TrendingDown className="h-4 w-4 text-red-600" />
                ) : (
                  <FlaskConical className="h-4 w-4 text-muted-foreground" />
                )}
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{conversionRate.rate}%</div>
                <div className="flex items-center gap-1">
                  <Badge variant={conversionRate.trend === 'up' ? 'default' : conversionRate.trend === 'down' ? 'destructive' : 'secondary'}>
                    {conversionRate.trend === 'up' ? '+' : conversionRate.trend === 'down' ? '-' : ''}{conversionRate.change}%
                  </Badge>
                  <p className="text-xs text-muted-foreground">
                    vs. mês anterior
                  </p>
                </div>
              </CardContent>
            </Card>
          </div>
      </div>

      {/* Seção de Testes e Conversão */}
      <div className="space-y-4">
          <h2 className="text-xl font-semibold tracking-tight">Testes e Conversão</h2>
          <div className="grid gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Testes no Mês</CardTitle>
                <FlaskConical className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{metrics.testsThisMonth}</div>
                <p className="text-xs text-muted-foreground">
                  Total de testes gerados este mês
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Conversões no Mês</CardTitle>
                <UserCheck className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{conversionRate.conversions}</div>
                <p className="text-xs text-muted-foreground">
                  Testes que se tornaram clientes
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Tempo Médio de Teste</CardTitle>
                <Clock className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{conversionRate.avgTestDuration} dias</div>
                <p className="text-xs text-muted-foreground">
                  Duração média antes da conversão
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Testes Expirados</CardTitle>
                <UserX className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">{conversionRate.expiredTests}</div>
                <p className="text-xs text-muted-foreground">
                  Testes que expiraram sem conversão
                </p>
              </CardContent>
            </Card>
          </div>
      </div>

      {/* Seção de KPIs e Performance */}
      <div className="space-y-4">
          <h2 className="text-xl font-semibold tracking-tight">KPIs e Performance</h2>
          <div className="grid gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Ticket Médio</CardTitle>
                <BarChart3 className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">
                  R$ {metrics.totalActiveClients > 0 ? (metrics.monthlyRevenue / metrics.totalActiveClients).toFixed(2) : '0.00'}
                </div>
                <p className="text-xs text-muted-foreground">
                  Valor médio por cliente ativo
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Taxa de Retenção</CardTitle>
                <Target className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">
                  {metrics.totalActiveClients > 0 ? ((metrics.totalActiveClients / (metrics.totalActiveClients + metrics.totalOverdueClients)) * 100).toFixed(1) : '0.0'}%
                </div>
                <p className="text-xs text-muted-foreground">
                  Clientes ativos vs. total
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Crescimento Mensal</CardTitle>
                <Activity className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">
                  {metrics.newCustomersThisMonth > 0 ? '+' : ''}{metrics.newCustomersThisMonth}
                </div>
                <p className="text-xs text-muted-foreground">
                  Novos clientes este mês
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-sm font-medium">Eficiência de Conversão</CardTitle>
                <Zap className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-2xl font-bold">
                  {conversionRate.rate > 0 ? conversionRate.rate : '0.0'}%
                </div>
                <div className="flex items-center gap-1">
                  <Badge variant={conversionRate.trend === 'up' ? 'default' : conversionRate.trend === 'down' ? 'destructive' : 'secondary'} className="text-xs">
                    {conversionRate.trend === 'up' ? '↗' : conversionRate.trend === 'down' ? '↘' : '→'} {conversionRate.change}%
                  </Badge>
                </div>
              </CardContent>
            </Card>
          </div>
      </div>

      {/* Seção de Sistema de Mensagens */}
      <div className="space-y-4">
        <h2 className="text-xl font-semibold tracking-tight">Sistema de Mensagens</h2>
        {/* Widget de mensagens temporariamente removido */}
      </div>
      
      {/* Seção de Listas Rápidas */
        <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-2">
          <Card>
              <CardHeader>
                  <CardTitle>Clientes Vencendo Hoje</CardTitle>
                  <CardDescription>
                      Estes clientes precisam renovar a assinatura hoje.
                  </CardDescription>
              </CardHeader>
              <CardContent>
                  <div className="space-y-4">
                      {metrics.expiringToday.length > 0 ? metrics.expiringToday.map(client => (
                          <div key={client.id} className="flex items-center">
                                <Avatar className="h-9 w-9">
                                  <AvatarFallback>{client.name.charAt(0)}</AvatarFallback>
                              </Avatar>
                              <div className="ml-4 space-y-1">
                                  <p className="text-sm font-medium leading-none">{client.name}</p>
                                  <p className="text-sm text-muted-foreground">{allPlans.find(p => p.id === client.planId)?.name}</p>
                              </div>
                              <Button asChild variant="ghost" size="sm" className="ml-auto font-medium">
                                  <Link href={`/clientes/${client.id}`}>Ver</Link>
                              </Button>
                          </div>
                      )) : <p className="text-sm text-muted-foreground">Nenhum cliente vencendo hoje.</p>}
                  </div>
              </CardContent>
          </Card>
          <Card>
              <CardHeader>
                  <CardTitle>Novos Clientes Adicionados</CardTitle>
                  <CardDescription>
                      Os últimos 5 clientes que se tornaram ativos.
                  </CardDescription>
              </CardHeader>
              <CardContent>
                    <div className="space-y-4">
                      {metrics.recentlyAddedClients.length > 0 ? metrics.recentlyAddedClients.map(client => (
                            <div key={client.id} className="flex items-center">
                              <Avatar className="h-9 w-9">
                                  <AvatarFallback>{client.name.charAt(0)}</AvatarFallback>
                              </Avatar>
                              <div className="ml-4 space-y-1">
                                  <p className="text-sm font-medium leading-none">{client.name}</p>
                                  <p className="text-sm text-muted-foreground">
                                      Adicionado em <FormattedDate dateString={client.startDate} format="dd/MM/yyyy" />
                                  </p>
                              </div>
                              <Button asChild variant="ghost" size="sm" className="ml-auto font-medium">
                                    <Link href={`/clientes/${client.id}`}>Ver</Link>
                              </Button>
                          </div>
                      )) : <p className="text-sm text-muted-foreground">Nenhum cliente adicionado recentemente.</p>}
                  </div>
              </CardContent>
          </Card>
        </div>
    </div>
  );
}
