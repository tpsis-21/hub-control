import type { NextConfig } from "next";

const nextConfig: NextConfig = {
  eslint: {
    ignoreDuringBuilds: true,
  },
  
  // ============================================
  // OTIMIZAÇÕES DE PERFORMANCE
  // ============================================
  
  // Compressão e otimização
  compress: true,
  poweredByHeader: false,
  
  // Experimental features para performance
  experimental: {
    optimizeCss: true,
    optimizePackageImports: [
      '@radix-ui/react-icons',
      '@radix-ui/react-dialog',
      '@radix-ui/react-dropdown-menu',
      '@radix-ui/react-select',
      '@radix-ui/react-tabs',
      '@radix-ui/react-toast',
      'lucide-react',
      'recharts',
      'date-fns'
    ],
    // Lazy compilation para desenvolvimento
    webVitalsAttribution: ['CLS', 'LCP'],
  },
  
  // ============================================
  // CONFIGURAÇÃO DE IMAGENS
  // ============================================
  
  images: {
    remotePatterns: [
      {
        protocol: 'https',
        hostname: 'placehold.co',
      },
      {
        protocol: 'https',
        hostname: 'images.unsplash.com',
      },
      {
        protocol: 'https',
        hostname: 'avatars.githubusercontent.com',
      }
    ],
    // Otimizações de imagem
    formats: ['image/webp', 'image/avif'],
    minimumCacheTTL: 60,
    dangerouslyAllowSVG: true,
    contentSecurityPolicy: "default-src 'self'; script-src 'none'; sandbox;",
  },
  
  // ============================================
  // CONFIGURAÇÃO DO SERVIDOR
  // ============================================
  
  serverExternalPackages: ['@supabase/ssr'],
  
  // ============================================
  // CONFIGURAÇÃO WEBPACK
  // ============================================
  
  webpack: (config, { dev, isServer }) => {
    // Fallbacks para módulos Node.js
    config.resolve.fallback = {
      ...config.resolve.fallback,
      fs: false,
      net: false,
      tls: false,
      crypto: false,
      stream: false,
      url: false,
      zlib: false,
      http: false,
      https: false,
      assert: false,
      os: false,
      path: false,
    };
    
    // Otimizações de produção
    if (!dev && !isServer) {
      // Code splitting otimizado
      config.optimization = {
        ...config.optimization,
        splitChunks: {
          chunks: 'all',
          cacheGroups: {
            // Vendor chunk para bibliotecas principais
            vendor: {
              test: /[\/]node_modules[\/]/,
              name: 'vendors',
              priority: 10,
              reuseExistingChunk: true,
            },
            // Chunk específico para UI components
            ui: {
              test: /[\/]src[\/]components[\/]ui[\/]/,
              name: 'ui-components',
              priority: 20,
              reuseExistingChunk: true,
            },

            // Chunk para ícones
            icons: {
              test: /[\/]node_modules[\/](lucide-react)[\/]/,
              name: 'icons',
              priority: 25,
              reuseExistingChunk: true,
            },
            // Chunk para gráficos
            charts: {
              test: /[\/]node_modules[\/](recharts)[\/]/,
              name: 'charts',
              priority: 25,
              reuseExistingChunk: true,
            },
            // Chunk comum para código compartilhado
            common: {
              name: 'common',
              minChunks: 2,
              priority: 5,
              reuseExistingChunk: true,
            },
          },
        },
      };
      
      // Otimização de módulos
      config.optimization.moduleIds = 'deterministic';
      config.optimization.chunkIds = 'deterministic';
    }
    
    // Alias para imports mais limpos
    config.resolve.alias = {
      ...config.resolve.alias,
      '@': require('path').resolve(__dirname, 'src'),
    };
    
    // Ignorar arquivos desnecessários
    config.watchOptions = {
      ...config.watchOptions,
      ignored: [
        '**/node_modules/**',
        '**/.git/**',
        '**/.next/**',
        '**/dist/**',
        '**/build/**',
        '**/*.test.*',
        '**/*.spec.*',
      ],
    };
    
    return config;
  },
  
  // ============================================
  // HEADERS DE SEGURANÇA E PERFORMANCE
  // ============================================
  
  async headers() {
    return [
      {
        source: '/(.*)',
        headers: [
          {
            key: 'X-Frame-Options',
            value: 'DENY',
          },
          {
            key: 'X-Content-Type-Options',
            value: 'nosniff',
          },
          {
            key: 'Referrer-Policy',
            value: 'strict-origin-when-cross-origin',
          },
          {
            key: 'Permissions-Policy',
            value: 'camera=(), microphone=(), geolocation=()',
          },
        ],
      },
      {
        source: '/api/(.*)',
        headers: [
          {
            key: 'Cache-Control',
            value: 'no-store, max-age=0',
          },
        ],
      },
      {
        source: '/_next/static/(.*)',
        headers: [
          {
            key: 'Cache-Control',
            value: 'public, max-age=31536000, immutable',
          },
        ],
      },
    ];
  },
  
  // ============================================
  // REDIRECTS E REWRITES
  // ============================================
  
  async redirects() {
    return [];
  },
};

export default nextConfig;
